{
  "manifest_version": 3,
  "name": "Givsen Supplier",
  "version": "0.4.1",
  "description": "Adds an \"Add to Givsen\" button to AliExpress product pages. Sends the product and the selected option to your Givsen Supplier import list.",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Givsen Supplier settings", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://*.aliexpress.com/*", "https://*.aliexpress.us/*"],
      "js": ["page.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.aliexpress.com/*", "https://*.aliexpress.us/*"],
      "js": ["match.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
